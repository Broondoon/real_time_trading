## Database Sharding Configuration ##
ENABLE_SHARDING=true

# Auth Database Sharding
AUTH_DB_SHARD_COUNT=3
AUTH_DB_SHARD_KEY=id
AUTH_DB_SHARDING_ALGORITHM=mod
AUTH_DATABASE_URL_SHARD1=postgres://${AUTH_POSTGRES_USER}:${AUTH_POSTGRES_PASSWORD}@auth-shard-1:5432/${AUTH_POSTGRES_DB}_shard1?sslmode=disable
AUTH_DATABASE_URL_SHARD2=postgres://${AUTH_POSTGRES_USER}:${AUTH_POSTGRES_PASSWORD}@auth-shard-2:5432/${AUTH_POSTGRES_DB}_shard2?sslmode=disable
AUTH_DATABASE_URL_SHARD3=postgres://${AUTH_POSTGRES_USER}:${AUTH_POSTGRES_PASSWORD}@auth-shard-3:5432/${AUTH_POSTGRES_DB}_shard3?sslmode=disable

# User Management Database Sharding
USER_MANAGEMENT_DB_SHARD_COUNT=3
USER_MANAGEMENT_DB_SHARD_KEY=id
USER_MANAGEMENT_DB_SHARDING_ALGORITHM=mod
USER_MANAGEMENT_DATABASE_URL_SHARD1=postgres://${USER_MANAGEMENT_POSTGRES_USER}:${USER_MANAGEMENT_POSTGRES_PASSWORD}@user-management-shard-1:5432/${USER_MANAGEMENT_POSTGRES_DB}_shard1?sslmode=disable
USER_MANAGEMENT_DATABASE_URL_SHARD2=postgres://${USER_MANAGEMENT_POSTGRES_USER}:${USER_MANAGEMENT_POSTGRES_PASSWORD}@user-management-shard-2:5432/${USER_MANAGEMENT_POSTGRES_DB}_shard2?sslmode=disable
USER_MANAGEMENT_DATABASE_URL_SHARD3=postgres://${USER_MANAGEMENT_POSTGRES_USER}:${USER_MANAGEMENT_POSTGRES_PASSWORD}@user-management-shard-3:5432/${USER_MANAGEMENT_POSTGRES_DB}_shard3?sslmode=disable


# Service Replication on Startup
REPLICATIONS=10
ORDER_INITIATOR_REPLICATIONS=15

